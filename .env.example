APP_NAME=Denapax
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# HTTPS reverse-proxy ingress: trust only your deployment's known proxy IP/CIDR.
# For a protected single-hop proxy, REMOTE_ADDR trusts only the direct peer.
# Do not set '*' on an app reachable directly from the internet.
TRUSTED_PROXIES=
# Set to true in HTTPS-only production; leave unset during local HTTP development.
# SESSION_SECURE_COOKIE=true

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Customer OTP: enable only after approving an OTP pattern and testing the chosen provider.
# Default driver is disabled; four-digit codes expire in 120 seconds with three attempts.
CUSTOMER_SMS_DRIVER=disabled
CUSTOMER_SMS_URL=
CUSTOMER_SMS_TOKEN=
CUSTOMER_OTP_LENGTH=4
CUSTOMER_OTP_TTL=120
CUSTOMER_OTP_MAX_ATTEMPTS=3
MEDIANA_API_KEY=
MEDIANA_OTP_PATTERN_CODE=
MEDIANA_TIMEOUT=8
MEDIANA_CONNECT_TIMEOUT=3
# Manual receipt approval SMS (default OFF). Only after real bank verification.
# Pattern is optional: if supplied, it must be approved and include #ORDER#.
# Otherwise the Mediana Informational plain-message API is used.
MEDIANA_PAYMENT_APPROVAL_SMS_ENABLED=false
MEDIANA_PAYMENT_APPROVAL_PATTERN_CODE=
MEDIANA_PAYMENT_APPROVAL_PATTERN_PARAMETER=ORDER
SMSIR_API_KEY=
SMSIR_VERIFY_TEMPLATE_ID=
SMSIR_VERIFY_PARAMETER=HOURS
SMSIR_TIMEOUT=8
SMSIR_CONNECT_TIMEOUT=3

# Zarinpal v4 — disabled until merchant activation and HTTPS callback validation.
ZARINPAL_ENABLED=false
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=false

VITE_APP_NAME="${APP_NAME}"
